generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Участник семьи (ребёнок/взрослый) со своим цветом
model Member {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#14b8a6")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  tasks     Task[]
}

// Задача: еженедельная (weekdays "1,3,5") или разовая (date)
model Task {
  id        String   @id @default(cuid())
  title     String
  note      String   @default("")
  memberId  String?
  member    Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  time      String   @default("09:00")
  weekdays  String   @default("")
  date      String?
  sound     String?
  doneDates String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Заметка с мягким удалением в корзину
model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  trashed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Единственная строка настроек приложения
model AppSettings {
  id        String  @id @default("main")
  sound     String  @default("chime")
  reminders Boolean @default(true)
}
